<org.eventb.core.contextFile org.eventb.core.configuration="org.eventb.core.fwd" version="3">
  <org.eventb.core.carrierSet name="s0" org.eventb.core.identifier="POS" />
  <org.eventb.core.carrierSet name="s1" org.eventb.core.identifier="MODE" />
  <org.eventb.core.constant name="c0" org.eventb.core.identifier="pNeutral" />
  <org.eventb.core.constant name="c1" org.eventb.core.identifier="pLeft" />
  <org.eventb.core.constant name="c2" org.eventb.core.identifier="pRight" />
